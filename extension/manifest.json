{
  "manifest_version": 3,
  "name": "Glance",
  "version": "0.2.0",
  "description": "Earn from clearly labelled ads shown after AI replies on ChatGPT, Claude and Gemini.",
  "permissions": ["storage", "identity"],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*"],
      "js": ["ads.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://glancepay.vercel.app/*"],
      "js": ["site-sync.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Glance",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  }
}